{
  "$id": "https://rusty-spire.dev/schemas/solve-request-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "heuristic": {
      "enum": [
        "zero",
        "remaining_enemy_hp"
      ]
    },
    "include_replay": {
      "type": "boolean"
    },
    "limits": {
      "type": "object"
    },
    "mode": {
      "enum": [
        "exact",
        "approximate"
      ]
    },
    "policy": {
      "const": "minimize_hp_loss"
    },
    "schema_version": {
      "const": 1
    },
    "setup": {
      "$ref": "combat-setup-v2.schema.json"
    }
  },
  "required": [
    "schema_version",
    "setup"
  ],
  "type": "object"
}
