{
  "$id": "https://rusty-spire.dev/schemas/content-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cards": {
      "type": "array"
    },
    "characters": {
      "type": "array"
    },
    "enemies": {
      "type": "array"
    },
    "game_version": {
      "type": "string"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "sha256"
      ],
      "type": "object"
    },
    "relics": {
      "type": "array"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "package",
    "game_version",
    "characters",
    "cards",
    "enemies",
    "relics"
  ],
  "type": "object"
}
